# Database Connection URL (Updated with exact local DB name)
DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5432/FuseLMS_InklingsAcademy

# Security & Authentication (HTTP-Only Cookie Setup)
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost:4200
ENVIRONMENT=development

# --- Scheduled jobs & Automation Rules ---
ENABLE_SCHEDULER=true
TOKEN_CLEANUP_RETENTION_DAYS=30
TOKEN_CLEANUP_CRON_HOUR=2
FEE_VOUCHER_DEFAULT_AMOUNT=15000.0
FEE_VOUCHER_DUE_DAYS=14
FEE_VOUCHER_CRON_DAY=1
FEE_VOUCHER_CRON_HOUR=3